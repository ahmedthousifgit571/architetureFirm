# Server config for the static export on the client's cPanel host.
# Lives in public/ so `next build` copies it into out/ on every build.
#
# The host runs LiteSpeed, not Apache. LiteSpeed reads .htaccess using
# Apache syntax, so everything here applies as written.

# ---------------------------------------------------------------------
# Compression is already handled by LiteSpeed at the server level — the
# live site returns `Content-Encoding: br`. Declaring mod_deflate rules
# here would be redundant at best, so compression is deliberately omitted.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Caching. Files under _next/static carry a content hash in the filename,
# so a changed file is a changed URL — safe to cache forever. HTML must
# never be cached or a redeploy stays invisible to returning visitors.
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# Range requests — the hero videos are seeked/streamed by the browser.
# Apache serves these by default; this just makes the intent explicit.
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
</IfModule>

# ---------------------------------------------------------------------
# Routing.
#
# `trailingSlash: true` in next.config.ts makes the export write every
# route as <route>/index.html, so DirectoryIndex resolves /projects/ and
# /projects/residential/ natively. No .html rewriting is needed — and
# deliberately so: an earlier rewrite here broke /projects, because the
# export also emitted a projects/ directory that shadowed projects.html.
# ---------------------------------------------------------------------
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# Canonical host + HTTPS.
#
# These preserve behaviour the domain ALREADY has — the current live site
# 301s the apex to https://www and sends a 2-year HSTS header. Uploading
# this file replaces the existing .htaccess, so dropping either rule would
# be a regression: the apex would stop redirecting, and browsers that have
# cached the HSTS policy would still force HTTPS regardless.
#
# Safe to enable now: a valid certificate is already live on both the apex
# and www (AutoSSL has run), so nothing here points at an unsecured URL.
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # -------------------------------------------------------------------
  # Legacy URLs from the site this one replaces.
  #
  # The previous site had been live since 2022 and every one of these
  # paths still returns 200 today, so they are indexed. Without 301s they
  # all become 404s the moment we overwrite public_html, throwing away
  # the domain's accumulated search ranking.
  #
  # These run BEFORE the canonical rule and emit absolute https://www
  # targets, so a legacy URL resolves in one hop rather than two.
  #
  # /index.html deliberately has no rule — the new export puts its own
  # index.html at that exact path, so it keeps working on its own.
  # -------------------------------------------------------------------

  # <category>-projects.html maps 1:1 onto the new category slugs.
  RewriteRule ^(residential|commercial|apartment|government|interior|religious)-projects\.html$ https://www.srripositivebuilders.com/projects/$1/ [L,R=301,NC]
  RewriteRule ^roads-culverts\.html$ https://www.srripositivebuilders.com/projects/roads-culverts/ [L,R=301,NC]

  # Project index pages.
  RewriteRule ^(our-projects|completed-projects)\.html$ https://www.srripositivebuilders.com/projects/ [L,R=301,NC]

  # Pages with no direct equivalent — their content now lives on the
  # single-page home route, so send them there rather than to a 404.
  RewriteRule ^(about-us|our-clients|contact-us|enquiry|blogs|blog-details|services-details|best-construction-company-in-madurai)\.html$ https://www.srripositivebuilders.com/ [L,R=301,NC]

  # The old contact form handler. The new site uses WhatsApp and tel:
  # links instead, so nothing server-side replaces it.
  RewriteRule ^enquiry\.php$ https://www.srripositivebuilders.com/ [L,R=301,NC]

  # -------------------------------------------------------------------
  # Canonical host + HTTPS — catches everything the rules above did not.
  # -------------------------------------------------------------------
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^srripositivebuilders\.com$ [NC]
  RewriteRule ^(.*)$ https://www.srripositivebuilders.com/$1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
